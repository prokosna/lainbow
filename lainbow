}

analyze_cmd() {
  local models_arg=""
  local retry_failed=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --models)
        models_arg="$2"
        shift 2
        ;;
      --retry-failed)
        retry_failed=true
        shift
        ;;
      --help|-h)
        echo "Usage: ./lainbow analyze [--models a,b] [--retry-failed]"
        return 0
        ;;
      *)
        echo "Error: Unknown analyze option: $1" >&2
        return 1
        ;;
    esac
  done

  local payload="{}"
  if [ -n "$models_arg" ] || [ "$retry_failed" = true ]; then
    local parts=()
    if [ -n "$models_arg" ]; then
      local json_models
      json_models=$(printf '%s' "$models_arg" | awk -F',' '{for(i=1;i<=NF;i++) printf "%s\"%s\"", (i>1?", ":""), $i}')
      parts+=("\"models\": [${json_models}]")
    fi
    if [ "$retry_failed" = true ]; then
      parts+=("\"retry_failed\": true")
    fi
    payload="{"
    for i in "${!parts[@]}"; do
      if [ "$i" -gt 0 ]; then payload="${payload}, "; fi
      payload="${payload}${parts[$i]}"
    done
    payload="${payload}}"
  fi

  local port api_base response task_id
  port=$(get_env_val "WEB_API_PORT" "8000")
  api_base="http://127.0.0.1:${port}"
  echo "Starting song analysis with payload: $payload"
  response=$(curl -s -f -X POST "${api_base}/api/v1/batch/analyze/run" -H "Content-Type: application/json" -d "$payload") || {
    echo "Error: Failed to request song analysis at ${api_base}/api/v1/batch/analyze/run" >&2
    return 1
  }
  task_id=$(printf '%s\n' "$response" | sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
  if [ -z "$task_id" ]; then
    echo "Error: Failed to parse task ID from response: $response" >&2
    return 1
  fi
  poll_task "$task_id" "$api_base"
}

update_cmd() {
  git pull --ff-only
  compose build
  up_cmd "$@"
}

doctor_cmd() {
  echo "=== Docker Compose Version ==="
  if command -v docker >/dev/null 2>&1; then
    docker compose version || echo "docker compose version failed"
  else
    echo "docker not found"
  fi
  echo

  echo "=== Detected Accelerator ==="
  local detected_accel
  detected_accel=$(detect_accel)
  echo "Host detected accelerator: $detected_accel"

  local version img
  version=$(get_env_val "LAINBOW_VERSION" "local")
  img="lainbow/inference-${detected_accel}:${version}"
  if command -v docker >/dev/null 2>&1 && docker image inspect "$img" >/dev/null 2>&1; then
    echo "Inference image '$img' found. Running scripts/accel-check.sh..."
    scripts/accel-check.sh "$img" || echo "accel-check reported issues"
  else
    echo "Inference image '$img' does not exist yet (run ./lainbow setup or docker compose build)."
  fi
  echo

  echo "=== Music Directory ==="
  local music_dir
  music_dir=$(get_env_val "MUSIC_NAS_ROOT_DIR" "")
  if [ -z "$music_dir" ]; then
    echo "MUSIC_NAS_ROOT_DIR is not set in $ENV_FILE"
  elif [ ! -e "$music_dir" ]; then
    echo "Music directory '$music_dir' does not exist!"
  elif [ ! -r "$music_dir" ]; then
    echo "Music directory '$music_dir' is not readable!"
  else
    echo "Music directory '$music_dir' exists and is readable."
  fi
  echo

  echo "=== Published Ports Check ==="
  local ports=(
    "WEB_API_PORT:8000"
    "INFERENCE_API_PORT:8001"
    "POSTGRES_PORT:5433"
    "RABBITMQ_PORT:5672"
    "RABBITMQ_MANAGEMENT_PORT:15672"
    "QDRANT_PORT_HTTP:6333"
    "QDRANT_PORT_GRPC:6334"
  )
  for entry in "${ports[@]}"; do
    local var default_port p
    var="${entry%%:*}"
    default_port="${entry#*:}"
    p=$(get_env_val "$var" "$default_port")
    if is_port_in_use "$p"; then
      echo "Port $p ($var) is already in use by another process."
    else
      echo "Port $p ($var) is free."
    fi
  done
  echo

  echo "=== Free Disk Space ==="
  local data_dir models_dir
  data_dir=$(get_env_val "DATABASE_DATA_ROOT_DIR" ".")
  models_dir=$(get_env_val "LAINBOW_MODELS_DIR" "./models")
  echo "Data directory ($data_dir):"
  df -h "$data_dir" 2>/dev/null || echo "Unable to check disk space for $data_dir"
  echo "Models directory ($models_dir):"
  df -h "$models_dir" 2>/dev/null || echo "Unable to check disk space for $models_dir"
}

usage() {
  cat <<'EOF'
Usage: ./lainbow <command> [options]

Commands:
  setup     Set up .env configuration and download models
  up        Start services and wait for healthchecks
  down      Stop services
  status    Show service status and API health / statistics
  logs      Follow container logs
  scan      Start library scan task and wait for completion
  vacuum    Start library vacuum task and wait for completion
  analyze   Start song analysis task and wait for completion
  update    Pull updates, rebuild containers, and restart
  doctor    Diagnose system environment, GPU, ports, and disk space
  help      Show this help message

For subcommand options, run:
  ./lainbow setup --help
  ./lainbow analyze --help
EOF
}

main() {
  if [ $# -eq 0 ]; then
    usage
    exit 0
  fi

  local cmd="$1"
  shift

  case "$cmd" in
    setup)
      setup_cmd "$@"
      ;;
    up)
      up_cmd "$@"
      ;;
    down)
      down_cmd "$@"
      ;;
    status)
      status_cmd "$@"
      ;;
    logs)
      logs_cmd "$@"
      ;;
    scan)
      scan_cmd "$@"
      ;;
    vacuum)
      vacuum_cmd "$@"
      ;;
    analyze)
      analyze_cmd "$@"
      ;;
    update)
      update_cmd "$@"
      ;;
    doctor)
      doctor_cmd "$@"
      ;;
    help|--help|-h)
      usage
      ;;
    *)
      echo "Error: Unknown command '$cmd'" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
