# Copy to .env and edit. Only the first three settings are required.
MUSIC_DIR=/path/to/your/music          # same folder as MPD's music_directory
POSTGRES_PASSWORD=change-me            # password of the bundled database
ENGINE_TOKEN=lbe_0123456789abcdef0123456789abcdef_change-me  # lbe_<32 hex digits>_<secret>; shared by server and engine
COMPOSE_PROFILES=cpu                   # engine to run: cpu, cuda or rocm
#DATA_DIR=./data                       # holds postgres/ and models/
#PORT=8000                             # port the API listens on
#LAINBOW_VERSION=2                     # image tag to run
#GPU_GID=video                         # ROCm only: group that owns /dev/kfd and /dev/dri
#HSA_OVERRIDE_GFX_VERSION=11.0.0       # ROCm only: for GPUs ROCm does not officially support
# Analysis settings (LAINBOW_*) are optional; see docs/configuration.md.
