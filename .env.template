##### Compose Profiles #####
# Active profiles to start. For a single-host deployment: db,app,inference-cpu (or inference-cuda / inference-rocm).
# For multi-host setups, configure each host with the subset it runs (e.g. "db", "app", or "inference-cuda").
# Optional debug profile enables Flower (Celery dashboard): "db,app,inference-cpu,debug".
COMPOSE_PROFILES=db,app,inference-cpu


##### Project Name & Image Tag #####
# Docker Compose project name (defaults to lainbow). Prevents container naming collisions.
#LAINBOW_PROJECT_NAME=lainbow
# Image version tag (defaults to local).
#LAINBOW_VERSION=local


##### Music Library Directory #####
# Path to your music library's root folder on the host (mounted into batch worker as /music_library:ro).
# Required when running the batch worker.
#MUSIC_NAS_ROOT_DIR=./music_data


##### Data Directory #####
# Root directory on the host where database files are stored (postgres_data, rabbitmq_data, qdrant_data).
#DATABASE_DATA_ROOT_DIR=.


##### Database Credentials #####
# PostgreSQL credentials.
# Existing installations must set POSTGRES_PASSWORD=password (the old hard-coded default).
#POSTGRES_USER=user
#POSTGRES_PASSWORD=password
#POSTGRES_DB=lainbow_db

# RabbitMQ credentials.
# Existing installations must set RABBITMQ_DEFAULT_PASS=password (the old hard-coded default).
#RABBITMQ_DEFAULT_USER=user
#RABBITMQ_DEFAULT_PASS=password


##### Network & Published Ports #####
# Host IP address to bind published ports (defaults to 127.0.0.1 for security).
# Note: WEB_API_PORT binds to all interfaces (0.0.0.0) so external MPD clients like Sola MPD can connect.
#LAINBOW_BIND_ADDRESS=127.0.0.1

# Web API port (host-facing)
#WEB_API_PORT=8000

# Inference API port (host-facing)
#INFERENCE_API_PORT=8001

# Database ports (host-facing)
#POSTGRES_PORT=5433
#RABBITMQ_PORT=5672
#RABBITMQ_MANAGEMENT_PORT=15672
#QDRANT_PORT_HTTP=6333
#QDRANT_PORT_GRPC=6334


##### GPU / Accelerator Settings #####
# Numeric group ID for ROCm /dev/kfd device access (output of `stat -c %g /dev/kfd`).
# The slim base image does not contain a "render" group, so a numeric GID is required on ROCm hosts.
#LAINBOW_GPU_GID=video


##### Split-Host Connection Settings #####
# In a single-host setup, services communicate using internal Docker service names (postgres, rabbitmq, qdrant, inference).
# When deploying services across separate hosts, configure the remote addresses below for app/batch containers.

# Hostname or IP of the PostgreSQL server for app/batch containers (default: postgres)
#POSTGRES_HOST=postgres
# Port of the PostgreSQL server for app/batch containers (default: 5432)
#POSTGRES_CONNECT_PORT=5432

# Hostname or IP of the RabbitMQ server for app/batch containers (default: rabbitmq)
#RABBITMQ_HOST=rabbitmq
# Port of the RabbitMQ server for app/batch containers (default: 5672)
#RABBITMQ_CONNECT_PORT=5672

# Hostname or IP of the Qdrant server for app/batch containers (default: qdrant)
#QDRANT_HOST=qdrant
# Port of the Qdrant server for app/batch containers (default: 6333)
#QDRANT_CONNECT_PORT=6333

# Full URL of the Inference API server for app/batch containers (default: http://inference:8001)
#INFERENCE_API_URL=http://inference:8001


##### Models Directory #####
# Directory on the host where deep learning models are stored.
#LAINBOW_MODELS_DIR=./models


##### Inference Tuning #####
# Model manager mode for inference API: "single" (one model at a time, saves VRAM) or "multi" (keeps multiple in memory).
#INFERENCE_MODEL_MANAGER_MODE=single
# Timeout in seconds for audio embedding requests.
#INFERENCE_REQUEST_TIMEOUT=300.0
# Timeout in seconds for text embedding requests.
#INFERENCE_TEXT_TIMEOUT=30.0
# Comma-separated model names to load on inference server startup.
#INFERENCE_MODELS_TO_LOAD_ON_STARTUP=muq,muq_mulan
# Comma-separated model names pinned in memory (not evicted in single mode).
#INFERENCE_PINNED_MODELS=muq_mulan


##### Batch Tuning #####
# Number of parallel Celery worker processes.
#BATCH_CONCURRENCY=1
# Number of songs per batch processing chunk.
#TASK_CHUNK_SIZE=10
# Audio duration in seconds used for MuQ model inference.
#MUQ_FILE_DURATION_SEC=180
# Time in seconds after which a RUNNING task with no heartbeat is considered stale.
#TASK_STALE_AFTER_SEC=1800
